// Settle Loan Expert Prisma Schema
// Supports SQLite for instant local dev & PostgreSQL for production deployment on VPS

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String
  passwordHash String
  role         String      @default("ADMIN") // SUPER_ADMIN, ADMIN, LEAD_MANAGER, CONTENT_MANAGER
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  auditLogs    AuditLog[]
}

model Lead {
  id                String       @id @default(cuid())
  fullName          String
  mobile            String
  email             String?
  loanCategory      String       // Personal Loan, Credit Card Debt, Business Loan, Multiple Loans, Other
  outstandingAmount String?      // e.g. "Below ₹2 Lakhs", "₹2L - ₹5L", "₹5L - ₹10L", "₹10L - ₹25L", "Above ₹25L"
  preferredTime     String?      // Morning (9 AM - 12 PM), Afternoon (12 PM - 4 PM), Evening (4 PM - 7 PM), Any time
  description       String?
  status            String       @default("NEW") // NEW, CONTACTED, FOLLOW_UP, IN_PROGRESS, CONVERTED, CLOSED
  assignedTo        String?
  source            String       @default("website_form") // website_form, callback_modal, hero_enquiry, zoho_link
  consentGiven      Boolean      @default(true)
  followUpDate      DateTime?
  ipAddress         String?
  userAgent         String?
  notes             LeadNote[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model LeadNote {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorName String
  authorId   String?
  content    String
  createdAt  DateTime @default(now())
}

model BlogPost {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  excerpt         String
  content         String
  category        String   // Loan Settlement, Credit Score, Debt Relief, Banking Regulations, Financial Guidance
  featuredImage   String?
  imageAlt        String?
  author          String   @default("Settle Loan Expert Editorial Team")
  published       Boolean  @default(true)
  metaTitle       String?
  metaDescription String?
  readTime        String?  @default("5 min read")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String   @default("General") // General, Settlement, Process, Legal & Credit, Fees
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id          String   @id @default(cuid())
  clientName  String
  location    String?  // e.g. Mumbai, Delhi NCR, Bengaluru, Hyderabad, Pune
  loanType    String?  // e.g. Credit Card Settlement, Personal Loan Resolution
  story       String
  outcome     String?  // e.g. "Structured 1-time settlement with NOC received"
  isVerified  Boolean  @default(true)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail  String?
  action     String   // LOGIN, LOGOUT, CREATE_LEAD, UPDATE_LEAD_STATUS, ADD_LEAD_NOTE, CREATE_POST, UPDATE_POST, DELETE_POST, SYSTEM_SETUP
  entityType String   // Lead, BlogPost, User, FAQ, Settings
  entityId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
