// Settle Loan Expert Prisma Schema - PostgreSQL Production Target
// For deploying on Ubuntu / Debian / AlmaLinux VPS with PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String
  passwordHash String
  role         String      @default("ADMIN") // SUPER_ADMIN, ADMIN, LEAD_MANAGER, CONTENT_MANAGER
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  auditLogs    AuditLog[]
}

model Lead {
  id                String       @id @default(cuid())
  fullName          String
  mobile            String
  email             String?
  loanCategory      String
  outstandingAmount String?
  preferredTime     String?
  description       String?
  status            String       @default("NEW")
  assignedTo        String?
  source            String       @default("website_form")
  consentGiven      Boolean      @default(true)
  followUpDate      DateTime?
  ipAddress         String?
  userAgent         String?
  notes             LeadNote[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model LeadNote {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorName String
  authorId   String?
  content    String
  createdAt  DateTime @default(now())
}

model BlogPost {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  excerpt         String
  content         String
  category        String
  featuredImage   String?
  imageAlt        String?
  author          String   @default("Settle Loan Expert Editorial Team")
  published       Boolean  @default(true)
  metaTitle       String?
  metaDescription String?
  readTime        String?  @default("5 min read")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String   @default("General")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id          String   @id @default(cuid())
  clientName  String
  location    String?
  loanType    String?
  story       String
  outcome     String?
  isVerified  Boolean  @default(true)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail  String?
  action     String
  entityType String
  entityId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
